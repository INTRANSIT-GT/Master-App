{
  "name": "master-app-transportes",
  "version": "1.0.0",
  "private": true,
  "description": "Master App de Transportes · In Transit (PWA + Supabase)",
  "type": "module",
  "scripts": {
    "build:core": "node scripts/build-core.mjs && node scripts/gen-sql-permisos.mjs",
    "test:servidor": "node tests/servidor.test.mjs",
    "serve": "npx --yes http-server . -p 8080 -c-1",
    "test:cliente": "node tests/cliente-supabase.test.mjs",
    "test": "npm run test:servidor && npm run test:cliente && npm run test:admin && npm run test:piloto && npm run test:liquidacion",
    "test:admin": "node tests/administrador.test.mjs",
    "test:menu": "node tests/menu-admin.test.mjs",
    "test:piloto": "node tests/piloto-unidad.test.mjs",
    "test:encargado": "node tests/encargado.test.mjs",
    "test:visual": "node tests/prueba-visual.test.mjs",
    "test:demo": "node tests/exportar.test.mjs",
    "test:liquidacion": "node tests/liquidacion.test.mjs",
    "test:guias": "node tests/guias.test.mjs",
    "preparar:manuales": "node scripts/preparar-manuales.mjs",
    "graph:build": "python -m graphify extract . --code-only --force",
    "graph:update": "python -m graphify update .",
    "graph:report": "python -m graphify cluster-only .",
    "graph:query": "python -m graphify query",
    "graph:god": "python -m graphify god-nodes --top 20",
    "check:core": "node scripts/build-core.mjs && git diff --exit-code -- supabase/functions/api/core.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "jsdom": "^30.1.2"
  }
}
